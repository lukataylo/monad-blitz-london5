{
  "expo": {
    "name": "Forfit",
    "slug": "forfit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/icon.png",
      "backgroundColor": "#F7F2E5"
    },
    "scheme": "forfit",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.forfit.app",
      "icon": "./assets/images/icon.png",
      "splash": {
        "image": "./assets/images/icon.png",
        "backgroundColor": "#F7F2E5"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "resizeMode": "contain",
        "imageSize": 50,
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.forfit.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.5"
          },
          "android": {
            "compileSdkVersion": 35
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-sensors",
        {
          "motionPermission": "Forfit counts your steps to run your group challenge."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
